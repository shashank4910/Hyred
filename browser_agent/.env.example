# LLM keys — OpenAI is primary, Gemini is fallback.
# Set at least one. If both are set, OpenAI is used unless LLM_PROVIDER=gemini.
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Optional model overrides
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.0-flash

# Force a specific provider: "openai" (default) or "gemini"
LLM_PROVIDER=openai

# Set to "false" on local machine to watch the browser
# Set to "true" on Render/cloud (headless)
BROWSER_HEADLESS=true

# Port (Render sets this automatically)
PORT=8000
