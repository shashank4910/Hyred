# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google Gemini --- (https://aistudio.google.com/app/apikey)
# Free tier: very generous — Gemini 2.0 Flash costs ~₹0.002 per job application.
GEMINI_API_KEY=your-gemini-api-key

# --- Adzuna India --- (https://developer.adzuna.com/)
# Optional but strongly recommended for India-focused job listings.
# Free tier: 250 calls/month. Sign up, register an app, copy app_id + app_key.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Auth (single-user password gate) ---
# The password you'll use to sign in to the dashboard.
APP_PASSWORD=choose-a-strong-password
# Random secret used to sign session cookies. Run: openssl rand -hex 32
AUTH_SECRET=replace-with-32-byte-hex-string

# --- Auto Apply Agent ---
# URL of the deployed Python browser agent (browser_agent/ folder)
# Example: https://jobradar-apply-agent.onrender.com
APPLY_AGENT_URL=
# Must also be set as NEXT_PUBLIC so the frontend can open the SSE stream
NEXT_PUBLIC_APPLY_AGENT_URL=

# --- App URL (used for agent callbacks) ---
# Your Vercel deployment URL (no trailing slash)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# --- Optional ---
# Used only by the GitHub Actions cron to pick which profile to ingest.
INGEST_PROFILE_EMAIL=
# Optional secret to gate the /api/ingest HTTP endpoint and agent callbacks.
INGEST_SECRET=
