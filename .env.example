# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- OpenRouter --- (https://openrouter.ai/settings/keys)
# The ONLY chat provider: prepaid credit, no rate-limit roulette. Also serves
# embeddings via its OpenAI-compatible endpoint. Groq/Gemini/Cerebras/
# Bluesminds were removed Aug 2026 (Session 49) - every free tier was dead or
# 429ing and the fallback chain made calls slow + flaky.
OPENROUTER_API_KEY=sk-or-...

# --- OpenAI --- (paid LAST resort for chat)
OPENAI_API_KEY=sk-...

# --- Job Sources ---

# Adzuna India (https://developer.adzuna.com/)
# Free tier: 250 calls/month per account.
# OPTION A: Multi-account rotation (recommended for unlimited usage)
#   Create multiple free Adzuna accounts, register an app on each.
#   Format: ADZUNA_CREDENTIALS=appId1:appKey1,appId2:appKey2,appId3:appKey3
ADZUNA_CREDENTIALS=
# OPTION B: Legacy single account (still works, backward compatible)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# JSearch via RapidAPI (https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch)
# Aggregates: Indeed, LinkedIn, Glassdoor, ZipRecruiter, Google Jobs.
# Free tier: ~200 requests/month per account.
# Multi-key rotation: create multiple RapidAPI accounts, comma-separate keys.
# Format: JSEARCH_API_KEYS=key1,key2,key3,key4,key5
# The system automatically rotates to the next key when one hits rate limit.
JSEARCH_API_KEYS=

# Himalayas.app — NO KEY NEEDED (free public API, always enabled)
# Nothing to configure here. Jobs are fetched automatically.

# --- Auth (Supabase Auth) ---
# User auth is handled by Supabase Auth (email/password + Google) using the
# NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_ANON_KEY above — no extra
# env needed for sign-in. Setup steps (Supabase dashboard):
#   1. Authentication > Providers > Email: enabled (toggle "Confirm email" as
#      you prefer; off = instant sign-in for testing).
#   2. Authentication > Providers > Google: enable + paste Google OAuth client
#      id/secret (from Google Cloud console).
#   3. Authentication > URL Configuration: set Site URL to your app URL and add
#      <app-url>/auth/callback (and http://localhost:3000/auth/callback) to
#      "Redirect URLs".
#   4. Run supabase/migrations/0005_multiuser.sql in the SQL editor.

# Email of the single admin user who can access /admin (API keys + usage).
# Leave blank to disable the Admin area entirely.
ADMIN_EMAIL=you@example.com

# APP_PASSWORD is now used ONLY by the browser extension auth exchange
# (/api/extension/auth). Not used for web sign-in anymore.
APP_PASSWORD=choose-a-strong-password

# --- Auto Apply Agent ---
# URL of the deployed Python browser agent (browser_agent/ folder)
# Example: https://jobradar-apply-agent.onrender.com
APPLY_AGENT_URL=
# Must also be set as NEXT_PUBLIC so the frontend can open the SSE stream
NEXT_PUBLIC_APPLY_AGENT_URL=

# --- App URL (used for agent callbacks) ---
# Your Vercel deployment URL (no trailing slash)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# --- Optional ---
# Used only by the GitHub Actions cron to pick which profile to ingest.
INGEST_PROFILE_EMAIL=
# Optional secret to gate the /api/ingest HTTP endpoint and agent callbacks.
INGEST_SECRET=
