# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google Gemini --- (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-key

# --- Auth (single-user password gate) ---
# The password you'll use to sign in to the dashboard.
APP_PASSWORD=choose-a-strong-password
# Random secret used to sign session cookies. Run: openssl rand -hex 32
AUTH_SECRET=replace-with-32-byte-hex-string

# --- Optional ---
# Used only by the GitHub Actions cron to pick which profile to ingest.
# Leave blank to use the first profile in the DB.
INGEST_PROFILE_EMAIL=
# Optional secret to gate the /api/ingest HTTP endpoint (separate from cron script).
INGEST_SECRET=
